                  "key": "about_price_assurance",
                  "heading": "6thStreet Price Assurance",
                  "body": "At 6thStreet, we promise the best deal every time. If you find the same item at a lower price on another website or app, we’ll refund the difference to your My Cash account."
                },
                {
                  "id": 2,
                  "type": "steps",
                  "key": "term_and_condition",
                  "bulletType": "dots",
                  "heading": "Terms & Conditions (“T&C”)",
                  "body": {
                    "points": [
                      {
                        "id": 1,
                        "desc": "Applicable only on products listed on online stores or 6thStreet Phygital Store."
                      },
                      {
                        "id": 2,
                        "desc": "Applies to identical products only — same brand, color, size, and style. Variations are not eligible."
                      },
                      {
                        "id": 3,
                        "desc": "All products listed on 6thStreet are eligible for price assurance."
                      },
                      {
                        "id": 4,
                        "desc": "The lower price must be in the same currency (AED, SAR, OMR, KWD, BHD, QAR)."
                      },
                      {
                        "id": 5,
                        "desc": "Claims must be submitted within 2 days of delivery and only after the payment is made by the Customer."
                      },
                      {
                        "id": 6,
                        "desc": "Price assurance is based on the individual item price, not the total order value."
                      },
                      {
                        "id": 7,
                        "desc": "If the product is subject to sale on 6thStreet within 2 days of delivery, only the difference from the sale pricing shall be refundable — as long as the size and color match your purchase."
                      },
                      {
                        "id": 8,
                        "desc": "A customer is entitled to claim the 6thStreet Price Assurance only one time for each product purchased. Further price drops after a claim is approved do not qualify for any refund."
                      },
                      {
                        "id": 9,
                        "desc": "Once an item has been price assured, it will no longer be eligible for return."
                      },
                      {
                        "id": 10,
                        "desc": "The T&C are subject to change. Customers are requested to check the T&C page for the latest version."
                      }
                    ]
                  }
